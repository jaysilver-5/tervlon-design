# Copy to .env.local. The app runs fully on mock data with these defaults —
# no backend required. Flip DATA_SOURCE to "live" once the NestJS API is reachable.

# Where the NestJS backend lives (only used when DATA_SOURCE=live)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# "mock" → served from src/mocks fixtures (default).
# "live" → hits NEXT_PUBLIC_API_BASE_URL through the auth fetch wrapper.
NEXT_PUBLIC_DATA_SOURCE=mock
